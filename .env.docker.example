# Copia a .env o usa junto con docker compose.
# Para Mongo local: docker compose --profile local-db up --build
# y descomenta COMPOSE_MONGODB_URI abajo.

PORT=3000
API_PORT=3000

# --- Base de datos ---
# Atlas (recomendado si ya lo usas):
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/pathway?retryWrites=true&w=majority
# Mongo del compose (solo con --profile local-db):
# COMPOSE_MONGODB_URI=mongodb://mongo:27017/pathway

JWT_SECRET=cambia-esto-por-un-secreto-largo
ALLOW_REGISTRATION=true
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=4194304
JWT_EXPIRES_IN=30d
NODE_ENV=production
SESSION_COOKIE_NAME=pw_session

# Front (Next). En local con Docker API + Next en el PC:
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
PUBLIC_APP_ORIGIN=http://localhost:5500
PORTAL_BASE_URL=http://localhost:5500
MAGIC_LINK_TTL_DAYS=30

# OpenAI (extracción pasaporte) — o EXTRACTION_MOCK=true para demo sin coste
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
# EXTRACTION_MOCK=true

# Resend (sandbox: solo tu email verificado hasta tener dominio)
RESEND_API_KEY=
RESEND_FROM=PathWay <onboarding@resend.dev>
