PORT=3000
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/pathway?retryWrites=true&w=majority
JWT_SECRET=wH2l+FN7jIiSQjOJ/Ss2SG+5yreZoOz7kLStTaZzpBg=
ALLOW_REGISTRATION=true
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=4194304
JWT_EXPIRES_IN=30d
# Varios orígenes separados por coma (front Next en 5500, o 127.0.0.1)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
NODE_ENV=development
SESSION_COOKIE_NAME=pw_session
# URL pública del front (portal / reset-password). También acepta PORTAL_BASE_URL.
PUBLIC_APP_ORIGIN=http://localhost:5500
PORTAL_BASE_URL=http://localhost:5500
# Caducidad del magic link en días (default 30)
MAGIC_LINK_TTL_DAYS=30

# Cerebro de PathWay — extracción OCR de pasaportes (POST /api/cases/:id/upload, magic upload-passport)
# Soporta JPG/PNG y PDF. La key SIEMPRE debe venir por variables de entorno.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o

# Desarrollo local sin OpenAI (elige uno):
# EXTRACTION_MOCK=true          → guarda archivo, no llama OpenAI, ingestionStatus=requires_review
# SKIP_PASSPORT_EXTRACTION=true → guarda archivo, ingestionStatus=processed sin IA
# EXTRACTION_MOCK=true
# SKIP_PASSPORT_EXTRACTION=true

# Plantilla PDF EX-10 (solo esta). Coloca EX10_template.pdf en pdf-templates/
# PDF_TEMPLATES_DIR=

# --- S3 opcional (PDF final + escaneo original del pasaporte) ---
# Si defines S3_BUCKET y región, el PDF final se sube al bucket y GET .../final-pdf
# redirige a una URL prefirmada (?redirect=0 devuelve JSON { url }).
# El archivo subido en /upload también se guarda en S3 bajo .../passports/<agencyId>/<caseId>/
# y se registra en expediente.archivosS3 (tipo passport). GET .../passport-original devuelve presign.
# S3_BUCKET=
# AWS_REGION=eu-west-1
# S3_REGION=eu-west-1
# Prefijo de claves dentro del bucket (sin slashes extremos)
# S3_KEY_PREFIX=pathway
# Credenciales (en EC2 con rol IAM pueden omitirse)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MinIO / R2: endpoint + path-style
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# TTL del enlace prefirmado en segundos (60–86400)
# S3_PRESIGN_TTL_SECONDS=3600

# --- Resend (magic link, rechazo doc, aprobación expediente, reset password) ---
# Sandbox: solo envía a emails verificados en tu cuenta Resend.
# Producción: verifica dominio en resend.com/domains y usa RESEND_FROM con ese dominio.
# RESEND_API_KEY=re_...
# RESEND_FROM=PathWay <onboarding@resend.dev>

# Enlace opcional en el pie del email de magic link al portal cliente
# PRIVACY_POLICY_URL=https://tudominio.com/privacidad

# --- Stripe (suscripción despacho) ---
# sk_test_... solo en .env (NUNCA en el front ni en el código fuente).
# STRIPE_SECRET_KEY=sk_test_...
# Webhook local: stripe listen --forward-to localhost:3000/api/billing/webhook
# STRIPE_WEBHOOK_SECRET=whsec_...
# Opcional: Price ID; si vacío, Checkout usa 75 €/mes (billing.priceMonthly)
# STRIPE_PRICE_ID=price_...
# Días de prueba en Checkout (default 7; 0 = sin trial)
# STRIPE_TRIAL_DAYS=7
